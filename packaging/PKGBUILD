# Maintainer: Julio Cesar <julio@byjuliocesa.dev>
pkgname=lyricslens
pkgver=0.1.38
pkgrel=1
pkgdesc="Synced lyrics overlay for Linux"
arch=('x86_64')
url="https://github.com/byjuliocesa/lyricslens"
license=('MIT')
depends=('gtk4' 'gtk4-layer-shell' 'libadwaita')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # The MPRIS tests publish a player, which needs a session bus of their own.
  dbus-run-session -- cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  ln -sf "$pkgname" "$pkgdir/usr/bin/lls"
  install -Dm644 "packaging/$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
  for size in 32 64 128 256; do
    install -Dm644 "packaging/icons/$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$pkgname.png"
  done
  install -Dm644 packaging/completions/lyricslens.bash "$pkgdir/usr/share/bash-completion/completions/$pkgname"
  ln -sf "$pkgname" "$pkgdir/usr/share/bash-completion/completions/lls"
  install -Dm644 packaging/completions/_lyricslens "$pkgdir/usr/share/zsh/site-functions/_$pkgname"
  install -Dm644 packaging/completions/lyricslens.fish "$pkgdir/usr/share/fish/vendor_completions.d/$pkgname.fish"
  ln -sf "$pkgname.fish" "$pkgdir/usr/share/fish/vendor_completions.d/lls.fish"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
